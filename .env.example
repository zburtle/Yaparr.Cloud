# Accounts and signup codes in Postgres instead of files (docs/setup-guide.md, "Moving to Postgres"). All three together:
#COMPOSE_PROFILES=postgres
#POSTGRES_PASSWORD=a long random password
#SERVICE_DATABASE=Host=postgres;Database=yaparr;Username=yaparr;Password=the same password

# The name Caddy gets an https certificate for. It has to point at this machine already (a DNS A record). The default is cloud.yaparr.com.
#DOMAIN=cloud.yaparr.com

# Ports on this computer. All optional; these are the defaults.
# Caddy, the one that faces the internet (it needs 80 and 443 for the certificate):
#HTTP_PORT=80
#HTTPS_PORT=443
# The service itself, for looking at it from this computer or for a proxy of your own instead of Caddy
# (127.0.0.1 keeps it to this computer; 0.0.0.0 opens it to others, as plain http):
#SERVICE_BIND=127.0.0.1
#SERVICE_PORT=8080
