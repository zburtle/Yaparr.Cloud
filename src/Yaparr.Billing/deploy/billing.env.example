# Add these to .env on the host (see docker-compose.billing.yml).
#COMPOSE_FILE=docker-compose.yml:/path/to/Yaparr.Billing/deploy/docker-compose.billing.yml
#PLUGINS_DIR=/path/to/the/folder/with/Yaparr.Billing.dll
#BILLING_PROVIDER=polar
#POLAR_SERVER=sandbox            # sandbox or production
#POLAR_ACCESS_TOKEN=
#POLAR_WEBHOOK_SECRET=           # whsec_..., of the webhook endpoint that points at https://<this service>/billing/webhook/polar
#POLAR_CLOUD_MONTHLY_PRODUCT=
#POLAR_CLOUD_YEARLY_PRODUCT=
