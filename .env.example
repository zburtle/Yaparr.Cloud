# The name that points at this machine, like backup.example.org (no https://).
DOMAIN=

# Ports on this computer. All are optional; these are the defaults.
# Caddy, the one that faces the internet:
#HTTP_PORT=80
#HTTPS_PORT=443
# The service itself, for a proxy you already run (SERVICE_BIND=127.0.0.1 keeps it to this computer; 0.0.0.0 opens it to others, as plain http):
#SERVICE_BIND=127.0.0.1
#SERVICE_PORT=8080
