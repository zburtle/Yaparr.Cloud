# Accounts and signup codes in Postgres instead of files (docs/setup-guide.md, "Moving to Postgres"). All three together:
#COMPOSE_PROFILES=postgres
#POSTGRES_PASSWORD=a long random password
#SERVICE_DATABASE=Host=postgres;Database=yaparr;Username=yaparr;Password=the same password

# Backups in an S3-compatible bucket instead of files (docs/setup-guide.md, "Moving the backups to S3"). For Cloudflare R2 the endpoint is
# https://<account id>.r2.cloudflarestorage.com (without the bucket name) and the region is auto; for DigitalOcean Spaces the endpoint is
# https://<region>.digitaloceanspaces.com and the region is the region (nyc3). Make the key one that can read and write that one bucket only.
#S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#S3_BUCKET=yaparr-backups
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_REGION=auto
#S3_CONDITIONAL_WRITES=true

# true: the service will not start unless SERVICE_DATABASE and the S3_* settings above are all set, so nothing is ever kept as files on this machine.
#REQUIRE_REMOTE_STORAGE=true

# The name Caddy gets an https certificate for. It has to point at this machine already (a DNS A record). The default is cloud.yaparr.com.
#DOMAIN=cloud.yaparr.com

# Ports on this computer. All optional; these are the defaults.
# Caddy, the one that faces the internet (it needs 80 and 443 for the certificate):
#HTTP_PORT=80
#HTTPS_PORT=443
# The service itself, for looking at it from this computer or for a proxy of your own instead of Caddy
# (127.0.0.1 keeps it to this computer; 0.0.0.0 opens it to others, as plain http):
#SERVICE_BIND=127.0.0.1
#SERVICE_PORT=8080

# The UDP gateway for devices on networks that block UDP (docs/setup-guide.md, "The UDP gateway"). Off unless COMPOSE_FILE adds its file; then the ports
# below have to be open for UDP, and GATEWAY_PUBLIC_ADDRESS is this machine's public IP address.
#COMPOSE_FILE=docker-compose.yml:docker-compose.gateway.yml
#GATEWAY_PUBLIC_ADDRESS=
#GATEWAY_PORT_MIN=40000
#GATEWAY_PORT_MAX=40099
#GATEWAY_MAX_CONNECTIONS=100

# What a payment decides (README, "Paid plans"). Off while BILLING_PROVIDER is empty; set it to the name of a provider that a plug-in answers to (the plug-in says which).
#BILLING_PROVIDER=

# Plug-ins (README, "Plug-ins"): a folder of plug-in assemblies, mounted read only. Empty or missing: none.
#PLUGINS_DIR=./plugins

# Email (README, "Email"). Off while MAIL_HOST is empty. Any SMTP server will do; keep the real password here, on the host, and nowhere else.
#MAIL_HOST=smtp.example.org
#MAIL_PORT=587
#MAIL_SECURITY=starttls          # starttls or none (none only for a server on this machine)
#MAIL_USER=
#MAIL_PASSWORD=
#MAIL_FROM=noreply@example.org   # on a domain whose SPF, DKIM and DMARC are set for the sending server
#MAIL_FROM_NAME=Yaparr Cloud
